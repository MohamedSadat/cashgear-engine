<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu draws with Vulkan, or OpenGL ES 3.0 where Vulkan is missing or broken. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- The engine's NativeActivity (cg_platform's android/java folder). It runs the game
             once per process, so it is never recreated: singleTask, every configuration
             change handled in place, and landscape only. -->
        <activity
            android:name="com.cashgear.engine.CashGearActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|touchscreen|uiMode|locale|layoutDirection|fontScale|fontWeightAdjustment|colorMode|grammaticalGender|mcc|mnc"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">

            <!-- lib{{crate_name}}_android.so, from android/src/lib.rs. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="{{crate_name}}_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
