// The sparks a checkpoint flag throws when it is reached: one burst, falling and fading
// from gold to orange. `scripts/checkpoint.lua` adds it to the flag.
(
    components: {
        "ParticleEmitter": (
            settings: (
                rate: 0,
                burst: 24,
                lifetime: (0.4, 0.8),
                speed: (40, 110),
                spread: 360,
                gravity: (0, -200),
                size: [3, 2],
                color: ["#ffcd75", "#ef7d5700"],
            ),
        ),
    },
)
