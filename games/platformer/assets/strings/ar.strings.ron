// Arabic strings for the platformer. Arabic is written right to left, so the whole UI
// mirrors while it is in use, and its text is drawn in Noto Kufi Arabic (the built-in
// pixel font has no Arabic letters).
(
    language: "ar",
    name: "العربية",
    right_to_left: true,
    font: Some("../fonts/arabic.font.ron"),
    strings: {
        "title": "CashGear",
        "subtitle": "لعبة منصات",
        "loading": "جارٍ التحميل",
        "menu.play": "العب",
        "menu.continue": "تابع: {level}",
        "menu.levels": "المراحل",
        "menu.settings": "الإعدادات",
        "menu.language": "اللغة: {name}",
        "menu.quit": "خروج",
        "menu.hint": "الأسهم أو WASD للتنقل، Enter للاختيار، Esc للرجوع.",
        "level.1": "الغابة الخضراء",
        "level.2": "كثبان الغروب",
        "level.3": "القمم الثلجية",
        "levels.title": "المراحل",
        "levels.entry": "{n}. {name}",
        "levels.best": "الأفضل: {coins}/{total} عملة، {time}",
        "levels.new": "لم تكتمل بعد",
        "levels.locked": "مقفلة",
        "settings.title": "الإعدادات",
        "settings.master": "الصوت",
        "settings.music": "الموسيقى",
        "settings.sfx": "المؤثرات",
        "settings.touch": "أزرار اللمس: {mode}",
        "settings.fullscreen": "ملء الشاشة: {mode}",
        "settings.controls": "التحكم",
        "touch.auto": "تلقائي",
        "touch.on": "تشغيل",
        "touch.off": "إيقاف",
        "controls.title": "التحكم",
        "controls.keys": "المفاتيح",
        "controls.pad": "يد التحكم",
        "controls.left": "يسار",
        "controls.right": "يمين",
        "controls.jump": "قفز",
        "controls.down": "أسفل",
        "controls.pause": "إيقاف مؤقت",
        "controls.empty": "-",
        // A binding's name, as the engine writes it (not translated).
        "controls.slot": "{name}",
        "controls.press": "اضغط...",
        "controls.hint": "اختر خانة ثم اضغط مفتاحًا أو زرًا. Esc للإلغاء.",
        "controls.reset": "استعادة",
        "back": "رجوع",
        "pause.title": "إيقاف مؤقت",
        "pause.resume": "متابعة",
        "pause.restart": "إعادة المرحلة",
        "pause.menu": "القائمة الرئيسية",
        "complete.title": "اكتملت المرحلة!",
        "complete.coins": "العملات: {coins}/{total}",
        "complete.time": "الوقت: {time}",
        "complete.best": "رقم قياسي جديد!",
        "complete.next": "المرحلة التالية",
        "complete.finish": "إنهاء",
        "complete.replay": "إعادة اللعب",
        "over.title": "انتهت اللعبة",
        "over.retry": "حاول مجددًا",
        "victory.title": "أحسنت!",
        "victory.text": "أنهيت المراحل الثلاث. أفضل العملات: {coins}/{total}",
    },
)
