// The title-screen logo: a big bunny with a ring of stars turning around it.
// The root is scaled 3x, and everything under it inherits that. Only the ring has
// `Spin`, so the stars orbit while the bunny stays still.
(
    components: {
        "Name": "logo",
        "Transform2D": (translation: (0, 10), scale: (3, 3)),
    },
    children: [
        (components: {
            "Name": "logo bunny",
            "Sprite": (texture: "images/bunny_white.png"),
        }),
        (
            components: {
                "Name": "star ring",
                "Transform2D": (),
                "Spin": (speed: 0.8),
            },
            children: [
                (components: { "Transform2D": (translation: (0, 22)), "Sprite": (texture: "generated/star", color: "#ffbe0b") }),
                (components: { "Transform2D": (translation: (19, 11)), "Sprite": (texture: "generated/star", color: "#fb5607") }),
                (components: { "Transform2D": (translation: (19, -11)), "Sprite": (texture: "generated/star", color: "#ff006e") }),
                (components: { "Transform2D": (translation: (0, -22)), "Sprite": (texture: "generated/star", color: "#8338ec") }),
                (components: { "Transform2D": (translation: (-19, -11)), "Sprite": (texture: "generated/star", color: "#3a86ff") }),
                (components: { "Transform2D": (translation: (-19, 11)), "Sprite": (texture: "generated/star", color: "#5ac54f") }),
            ],
        ),
    ],
)
