// A falling bunny in a party hat. The spawner sets its position and velocity; it bounces
// on the ground, blinks in its last second, then despawns with its hat.
(
    components: {
        "Sprite": (texture: "images/bunny_white.png", pivot: (0.5, 0)),
        "Layer": (1),
        "Interpolated": (),
        "Velocity": ((0, 0)),
        "Lifetime": (seconds: 6),
    },
    children: [
        (components: {
            "Transform2D": (translation: (1, 22)),
            "Sprite": (texture: "generated/hat", pivot: (0.5, 0), color: "#ff006e"),
            "Layer": (2),
        }),
    ],
)
