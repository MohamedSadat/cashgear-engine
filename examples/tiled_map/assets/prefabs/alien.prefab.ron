// A walking enemy. The map places it and can tune its patrol with a `Patrol` class
// property; the picture comes from the packed character atlas, two frames by name.
(
    components: {
        "AtlasSprite": (atlas: "atlases/characters.atlas.ron", region: "alien_0"),
        "Frames": (regions: ["alien_0", "alien_1"], fps: 5),
        "Patrol": (speed: 30, distance: 48),
    },
)
